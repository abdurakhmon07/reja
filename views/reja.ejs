<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>REJA — Rejalar va maqsadlar</title>

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <link rel="stylesheet" href="/reja.css" />
</head>

<body class="reja-page">
    <main class="reja-container">
        <header class="reja-header">
            <span class="reja-badge">Kundalik rejalar</span>
            <h1 class="reja-title">Reja va maqsadlar</h1>
            <p class="reja-subtitle">
                Bugungi rejalaringizni yozing, o'zgartiring va bajarilganlarini o'chiring.
            </p>
        </header>

        <section class="reja-card">
            <form id="create-form" class="reja-form" action="/create-item" method="POST">
                <label for="create-field" class="sr-only">Yangi reja</label>
                <input
                    id="create-field"
                    name="reja"
                    autofocus
                    autocomplete="off"
                    class="form-control reja-input"
                    type="text"
                    placeholder="Masalan: 30 daqiqa kitob o'qish"
                    required
                />
                <button type="submit" class="btn btn-primary reja-add-btn">
                    + Reja qo'shish
                </button>
            </form>
        </section>

        <section class="reja-card reja-list-card">
            <div class="reja-list-head">
                <h2 class="reja-list-title">Rejalarim</h2>
                <button id="clean-all" type="button" class="btn reja-clear-btn">
                    Hammasini o'chirish
                </button>
            </div>

            <ul id="item-list" class="list-group">
                <% items.forEach(function (item) { %>
                <li class="list-group-item list-group-item-info d-flex align-items-center justify-content-between">
                    <span class="item-text"><%= item.reja %></span>
                    <div>
                        <button data-id="<%= item._id %>" class="edit-me btn btn-secondary btn-sm mr-1">
                            Ozgartirish
                        </button>
                        <button data-id="<%= item._id %>" class="delete-me btn btn-danger btn-sm">
                            Ochirish
                        </button>
                    </div>
                </li>
                <% }) %>
            </ul>

            <div class="reja-empty">
                <div class="reja-empty-icon" aria-hidden="true">📝</div>
                <p class="reja-empty-title">Hozircha rejalar yo'q</p>
                <p class="reja-empty-text">Yuqoridagi maydonga birinchi rejangizni yozing.</p>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <script src="/browser.js"></script>
</body>
</html>
